# Downloaded checkpoints are versioned through Git LFS.
# Keep download metadata and temporary transfers local.
**/.cache/
*.part
*.incomplete

# Training datasets are downloaded locally, not redistributed with this fork.
/downloads/training-data/

# Unity-generated state; the original release ZIP preserves the shipped copy.
/echoavatar_unity/[Ll]ibrary/
/echoavatar_unity/[Tt]emp/
/echoavatar_unity/[Oo]bj/
/echoavatar_unity/[Bb]uild/
/echoavatar_unity/[Bb]uilds/
/echoavatar_unity/[Ll]ogs/
/echoavatar_unity/[Uu]ser[Ss]ettings/
/echoavatar_unity/.vs/

# Keep datasets local; split lists are tracked explicitly.
data*

# Python caches
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
**__pycache__**

# Local environments
.venv/
venv/
env/
.env

# Local outputs
logs/
runs/
wandb/
output*
*.log

# Editor and OS files
.vscode/
.DS_Store

# Agent
.agents
.claude
